# ============================================
# Git Ignore - Hallucination Detection in Pretrained Models
# ============================================

# Python byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# PyTorch checkpoints and model exports
*.pt
*.pth
*.bin
*.safetensors
checkpoint-*/
*_saved/
*.zip

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# Virtual Environments
venv/
env/
.venv/

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo

# Operating System Files
.DS_Store
Thumbs.db
Desktop.ini

# Logs and outputs
*.log
